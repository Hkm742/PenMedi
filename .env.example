# PostgreSQL Database Configuration
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=pm_password
POSTGRES_DB=pm_cdss
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Async Connection URL
DATABASE_URL=postgresql+asyncpg://pm_user:pm_password@localhost:5432/pm_cdss

# JWT Security Credentials
JWT_SECRET_KEY=penmed-cdss-super-secure-production-ready-jwt-key-cavendish-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
