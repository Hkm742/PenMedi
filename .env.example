# ==============================================================================
# PM-CDSS Database Configuration
# ==============================================================================
# Development (Localized PostgreSQL instance via Docker Compose or Localhost):
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=pm_password
POSTGRES_DB=pm_cdss
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pm_user:pm_password@localhost:5432/pm_cdss

# Production (Neon Cloud PostgreSQL connection string):
# Replace the DATABASE_URL below with your Neon DB connection string when deploying to Render:
# DATABASE_URL=postgresql://neondb_owner:npg_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# JWT Security Credentials
# ==============================================================================
JWT_SECRET_KEY=penmed-cdss-super-secure-production-ready-jwt-key-cavendish-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# Application & Deployment Settings
# ==============================================================================
ENVIRONMENT=development
AUTO_SEED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend Environment (Vite):
# Local: http://localhost:8000/api/v1 (or left empty for Vite dev proxy)
# Render Production: https://your-backend-service.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1
